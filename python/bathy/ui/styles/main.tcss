/* Main styles for Bathymesh TUI */

Screen {
    background: $surface;
}

/* Headers and footers */
Header {
    background: $primary;
    color: $text;
}

Footer {
    background: $panel;
}

/* General container styles */
.container {
    border: solid $primary;
    background: $surface;
    padding: 1 2;
    margin: 1;
}

/* Button styles */
Button {
    margin: 0 1;
}

Button:focus {
    text-style: bold;
}

/* Input styles */
Input {
    margin: 0 1;
}

Input:focus {
    border: tall $accent;
}

/* List and table styles */
DataTable {
    height: 100%;
}

DataTable > .datatable--cursor {
    background: $accent;
    color: $text;
}

/* Status indicators */
.status-none {
    color: $text-muted;
}

.status-image-loaded {
    color: $warning;
}

.status-heightmap-generated {
    color: $secondary;
}

.status-mesh-generated {
    color: $success;
}

/* Help text */
.help-text {
    color: $text-muted;
    text-style: italic;
    margin: 1 0;
}

/* Error messages */
.error {
    color: $error;
    text-style: bold;
}

/* Success messages */
.success {
    color: $success;
    text-style: bold;
}
