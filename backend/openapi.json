{
    "openapi": "3.1.0",
    "info": {
        "title": "Bathymesh API",
        "version": "0.1.0"
    },
    "paths": {
        "/": {
            "get": {
                "summary": "Root",
                "operationId": "root__get",
                "responses": {
                    "200": {
                        "description": "Successful Response",
                        "content": {
                            "application/json": {
                                "schema": {}
                            }
                        }
                    }
                }
            }
        },
        "/api/health": {
            "get": {
                "summary": "Health Check",
                "operationId": "health_check_api_health_get",
                "responses": {
                    "200": {
                        "description": "Successful Response",
                        "content": {
                            "application/json": {
                                "schema": {}
                            }
                        }
                    }
                }
            }
        },
        "/api/config/defaults": {
            "get": {
                "summary": "Defaults",
                "operationId": "defaults_api_config_defaults_get",
                "responses": {
                    "200": {
                        "description": "Successful Response",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/ProjectConfig-Output"
                                }
                            }
                        }
                    }
                }
            }
        },
        "/api/config/{project_id}": {
            "get": {
                "summary": "Get Project Config",
                "operationId": "get_project_config_api_config__project_id__get",
                "parameters": [
                    {
                        "name": "project_id",
                        "in": "path",
                        "required": true,
                        "schema": {
                            "type": "string",
                            "title": "Project Id"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Successful Response",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/ProjectConfig-Output"
                                }
                            }
                        }
                    },
                    "422": {
                        "description": "Validation Error",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/HTTPValidationError"
                                }
                            }
                        }
                    }
                }
            },
            "put": {
                "summary": "Set Project Config",
                "operationId": "set_project_config_api_config__project_id__put",
                "parameters": [
                    {
                        "name": "project_id",
                        "in": "path",
                        "required": true,
                        "schema": {
                            "type": "string",
                            "title": "Project Id"
                        }
                    }
                ],
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "$ref": "#/components/schemas/ProjectConfig-Input"
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "Successful Response",
                        "content": {
                            "application/json": {
                                "schema": {}
                            }
                        }
                    },
                    "422": {
                        "description": "Validation Error",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/HTTPValidationError"
                                }
                            }
                        }
                    }
                }
            }
        },
        "/api/config/validate": {
            "post": {
                "summary": "Validate Project Config",
                "operationId": "validate_project_config_api_config_validate_post",
                "requestBody": {
                    "content": {
                        "application/json": {
                            "schema": {
                                "$ref": "#/components/schemas/ProjectConfig-Input"
                            }
                        }
                    },
                    "required": true
                },
                "responses": {
                    "200": {
                        "description": "Successful Response",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "boolean",
                                    "title": "Response Validate Project Config Api Config Validate Post"
                                }
                            }
                        }
                    },
                    "422": {
                        "description": "Validation Error",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/HTTPValidationError"
                                }
                            }
                        }
                    }
                }
            }
        }
    },
    "components": {
        "schemas": {
            "ContourExtractionConfig": {
                "properties": {
                    "min_polygon_area": {
                        "type": "number",
                        "title": "Min Polygon Area",
                        "description": "Minimum polygon area for contour extraction",
                        "default": 0.01
                    },
                    "simplify_tolerance": {
                        "type": "number",
                        "title": "Simplify Tolerance",
                        "description": "Tolerance for simplifying extracted contours",
                        "default": 0.5
                    },
                    "max_segments": {
                        "type": "integer",
                        "title": "Max Segments",
                        "description": "Maximum number of segments for contour extraction",
                        "default": 100
                    },
                    "min_area_fraction": {
                        "type": "number",
                        "title": "Min Area Fraction",
                        "description": "Minimum area fraction for contour extraction",
                        "default": 0.01
                    }
                },
                "type": "object",
                "title": "ContourExtractionConfig"
            },
            "HTTPValidationError": {
                "properties": {
                    "detail": {
                        "items": {
                            "$ref": "#/components/schemas/ValidationError"
                        },
                        "type": "array",
                        "title": "Detail"
                    }
                },
                "type": "object",
                "title": "HTTPValidationError"
            },
            "HeighmapProcessingConfig": {
                "properties": {
                    "exterior_buffer_width": {
                        "type": "integer",
                        "title": "Exterior Buffer Width",
                        "default": 0
                    },
                    "exterior_buffer_value": {
                        "type": "number",
                        "title": "Exterior Buffer Value",
                        "default": 0.0
                    },
                    "data_offset": {
                        "type": "number",
                        "title": "Data Offset",
                        "default": 0
                    },
                    "mesh_units": {
                        "$ref": "#/components/schemas/MeshUnits"
                    },
                    "thresholds": {
                        "items": {
                            "type": "number"
                        },
                        "type": "array",
                        "title": "Thresholds",
                        "description": "List of height thresholds for each level"
                    },
                    "base_height": {
                        "type": "number",
                        "title": "Base Height",
                        "description": "Z-coordinate of the base level",
                        "default": 0.0
                    },
                    "layer_thickness": {
                        "type": "number",
                        "title": "Layer Thickness",
                        "description": "Thickness of each extruded layer",
                        "default": 0.5
                    }
                },
                "type": "object",
                "title": "HeighmapProcessingConfig"
            },
            "ImageProcessingConfig": {
                "properties": {
                    "preserve_full_resolution": {
                        "type": "boolean",
                        "title": "Preserve Full Resolution",
                        "description": "Whether to preserve full image resolution",
                        "default": true
                    },
                    "max_dimension": {
                        "anyOf": [
                            {
                                "type": "integer"
                            },
                            {
                                "type": "null"
                            }
                        ],
                        "title": "Max Dimension",
                        "description": "Maximum dimension (width/height) for resizing images"
                    },
                    "region": {
                        "anyOf": [
                            {
                                "prefixItems": [
                                    {
                                        "type": "integer"
                                    },
                                    {
                                        "type": "integer"
                                    },
                                    {
                                        "type": "integer"
                                    },
                                    {
                                        "type": "integer"
                                    }
                                ],
                                "type": "array",
                                "maxItems": 4,
                                "minItems": 4
                            },
                            {
                                "type": "null"
                            }
                        ],
                        "title": "Region",
                        "description": "Region of interest in the format (left, upper, right, lower)"
                    },
                    "fill_nan_values": {
                        "type": "boolean",
                        "title": "Fill Nan Values",
                        "description": "Whether to fill NaN values in images",
                        "default": true
                    },
                    "fill_max_iterations": {
                        "type": "integer",
                        "title": "Fill Max Iterations",
                        "description": "Maximum iterations for filling NaN values",
                        "default": 100
                    },
                    "fill_neighborhood": {
                        "type": "integer",
                        "title": "Fill Neighborhood",
                        "description": "Neighborhood size for filling NaN values",
                        "default": 1
                    },
                    "color_map": {
                        "additionalProperties": true,
                        "type": "object",
                        "title": "Color Map",
                        "description": "Color to value mapping with fuzziness"
                    },
                    "default_fuzziness": {
                        "type": "number",
                        "title": "Default Fuzziness",
                        "description": "Default fuzziness value (Delta E) when not specified",
                        "default": 10.0
                    }
                },
                "type": "object",
                "title": "ImageProcessingConfig"
            },
            "MeshCombinationConfig": {
                "properties": {
                    "merge_threshold": {
                        "type": "number",
                        "title": "Merge Threshold",
                        "description": "Threshold for merging close vertices when combining meshes",
                        "default": 1e-06
                    }
                },
                "type": "object",
                "title": "MeshCombinationConfig"
            },
            "MeshGenerationConfig-Input": {
                "properties": {
                    "stateless": {
                        "type": "boolean",
                        "title": "Stateless",
                        "description": "Whether to run in stateless mode (no visualizations)",
                        "default": true
                    },
                    "heightmap_processing": {
                        "$ref": "#/components/schemas/HeighmapProcessingConfig"
                    },
                    "mesh_combination": {
                        "$ref": "#/components/schemas/MeshCombinationConfig"
                    },
                    "contour_extraction": {
                        "$ref": "#/components/schemas/ContourExtractionConfig"
                    },
                    "triangulation": {
                        "$ref": "#/components/schemas/TriangulationConfig"
                    },
                    "post_processing": {
                        "$ref": "#/components/schemas/PostProcessingConfig"
                    }
                },
                "type": "object",
                "title": "MeshGenerationConfig"
            },
            "MeshGenerationConfig-Output": {
                "properties": {
                    "stateless": {
                        "type": "boolean",
                        "title": "Stateless",
                        "description": "Whether to run in stateless mode (no visualizations)",
                        "default": true
                    },
                    "heightmap_processing": {
                        "$ref": "#/components/schemas/HeighmapProcessingConfig"
                    },
                    "mesh_combination": {
                        "$ref": "#/components/schemas/MeshCombinationConfig"
                    },
                    "contour_extraction": {
                        "$ref": "#/components/schemas/ContourExtractionConfig"
                    },
                    "triangulation": {
                        "$ref": "#/components/schemas/TriangulationConfig"
                    },
                    "post_processing": {
                        "$ref": "#/components/schemas/PostProcessingConfig"
                    }
                },
                "type": "object",
                "title": "MeshGenerationConfig"
            },
            "MeshUnits": {
                "properties": {
                    "units_x": {
                        "type": "number",
                        "title": "Units X",
                        "default": 1.0
                    },
                    "units_y": {
                        "type": "number",
                        "title": "Units Y",
                        "default": 1.0
                    },
                    "units_z": {
                        "type": "number",
                        "title": "Units Z",
                        "default": 1.0
                    }
                },
                "type": "object",
                "title": "MeshUnits",
                "description": "Scaling parameters for mesh generation."
            },
            "PostProcessingConfig": {
                "properties": {
                    "apply_post_processing": {
                        "type": "boolean",
                        "title": "Apply Post Processing",
                        "description": "Whether to apply post-processing to meshes",
                        "default": true
                    },
                    "remove_degenerate_triangles": {
                        "type": "boolean",
                        "title": "Remove Degenerate Triangles",
                        "description": "Remove degenerate triangles",
                        "default": true
                    },
                    "remove_duplicated_vertices": {
                        "type": "boolean",
                        "title": "Remove Duplicated Vertices",
                        "description": "Remove duplicated vertices",
                        "default": true
                    },
                    "remove_duplicated_triangles": {
                        "type": "boolean",
                        "title": "Remove Duplicated Triangles",
                        "description": "Remove duplicated triangles",
                        "default": true
                    },
                    "remove_unreferenced_vertices": {
                        "type": "boolean",
                        "title": "Remove Unreferenced Vertices",
                        "description": "Remove unreferenced vertices",
                        "default": true
                    },
                    "merge_close_vertices": {
                        "type": "boolean",
                        "title": "Merge Close Vertices",
                        "description": "Merge vertices that are very close",
                        "default": false
                    },
                    "merge_vertices_threshold": {
                        "type": "number",
                        "title": "Merge Vertices Threshold",
                        "description": "Distance threshold for merging vertices",
                        "default": 1e-06
                    },
                    "simplification_method": {
                        "type": "string",
                        "title": "Simplification Method",
                        "description": "Method for mesh simplification",
                        "default": "none"
                    },
                    "target_triangle_count": {
                        "type": "integer",
                        "title": "Target Triangle Count",
                        "description": "Target triangle count for mesh simplification",
                        "default": 100000
                    },
                    "voxel_size": {
                        "type": "number",
                        "title": "Voxel Size",
                        "description": "Voxel size for vertex clustering simplification",
                        "default": 0.05
                    }
                },
                "type": "object",
                "title": "PostProcessingConfig"
            },
            "ProjectConfig-Input": {
                "properties": {
                    "mesh_generation": {
                        "$ref": "#/components/schemas/MeshGenerationConfig-Input"
                    },
                    "image_processing": {
                        "$ref": "#/components/schemas/ImageProcessingConfig"
                    }
                },
                "type": "object",
                "title": "ProjectConfig"
            },
            "ProjectConfig-Output": {
                "properties": {
                    "mesh_generation": {
                        "$ref": "#/components/schemas/MeshGenerationConfig-Output"
                    },
                    "image_processing": {
                        "$ref": "#/components/schemas/ImageProcessingConfig"
                    }
                },
                "type": "object",
                "title": "ProjectConfig"
            },
            "TriangulationConfig": {
                "properties": {
                    "triangulator_add_interior_points": {
                        "type": "boolean",
                        "title": "Triangulator Add Interior Points",
                        "description": "Whether to add interior points during triangulation",
                        "default": true
                    },
                    "triangulator_interior_point_density": {
                        "type": "number",
                        "title": "Triangulator Interior Point Density",
                        "description": "Density of interior points (points per unit area)",
                        "default": 1.0
                    }
                },
                "type": "object",
                "title": "TriangulationConfig"
            },
            "ValidationError": {
                "properties": {
                    "loc": {
                        "items": {
                            "anyOf": [
                                {
                                    "type": "string"
                                },
                                {
                                    "type": "integer"
                                }
                            ]
                        },
                        "type": "array",
                        "title": "Location"
                    },
                    "msg": {
                        "type": "string",
                        "title": "Message"
                    },
                    "type": {
                        "type": "string",
                        "title": "Error Type"
                    },
                    "input": {
                        "title": "Input"
                    },
                    "ctx": {
                        "type": "object",
                        "title": "Context"
                    }
                },
                "type": "object",
                "required": [
                    "loc",
                    "msg",
                    "type"
                ],
                "title": "ValidationError"
            }
        }
    }
}